@model List<ECommerceApp.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h2>Shopping Cart</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Your cart is empty!</div>
    <a asp-controller="Product" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Price EGP</td>
                    <td>@item.Quantity</td>
                    <td>@item.Total EGP</td>
                    <td>
                        <a asp-action="Remove" asp-route-id="@item.ProductId"
                           class="btn btn-danger btn-sm">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <h4>Total: @Model.Sum(x => x.Total) EGP</h4>
        <div>
            <a asp-action="Clear" class="btn btn-warning">Clear Cart</a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">Continue Shopping</a>
        </div>
    </div>
}